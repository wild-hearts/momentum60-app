# Public client configuration. Never prefix a server secret with VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_ORIGIN=https://challenge.themomentumrule.com
# The subscription product identifier (the same in App Store Connect and Google Play)
# and the Google Play base plan identifier. Neither is a secret.
VITE_NATIVE_PRODUCT_ID=
VITE_ANDROID_BASE_PLAN_ID=
# Server-only deployment configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
APP_ORIGIN=https://challenge.themomentumrule.com
CRON_SECRET=

# Store purchases are verified directly with Apple and Google.
NATIVE_PRODUCT_IDS=
# Numeric Apple ID of the app in App Store Connect (not a secret).
APPLE_APP_ID=
APPLE_BUNDLE_ID=com.themomentumrule.momentum60
GOOGLE_PLAY_PACKAGE=com.themomentumrule.momentum60
# Full JSON key of the Google Play service account. Secret: server only.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
BILLING_ENV=production

RESEND_API_KEY=
REMINDERS_ENABLED=false
